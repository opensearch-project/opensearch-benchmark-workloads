{
    "operation": {
        "name": "prod-queries",
        "operation-type": "vector-search",
        "param-source": "corpus-sample-vector-search-param-source",
        "index": "{{ target_index_name | default('target_index') }}",
        "detailed-results": true,
        {% if query_k is defined %}
        "k": {{ query_k }},
        {% elif query_body is not defined or query_body.query is not defined %}
        "k": 100,
        {% endif %}
        "field" : "{{ target_field_name | default('target_field') }}",
        "space_type": "{{ target_index_space_type | default('l2') }}",
        "data_set_format" : "{{ query_data_set_format | default('hdf5') }}",
        "data_set_path" : "{{ query_data_set_path | default('') }}",
        "data_set_corpus" : "{{ query_data_set_corpus | default('') }}",
        "corpus_data_set_format" : "{{ target_index_bulk_index_data_set_format | default('hdf5') }}",
        "corpus_data_set_path" : "{{ target_index_bulk_index_data_set_path | default('') }}",
        "corpus_data_set_corpus" : "{{ target_index_bulk_index_data_set_corpus | default('') }}",
        "num_vectors" : {{ query_count | default(10000) }},
        "repetitions": {{ repetitions | default(1) }},
        "query_noise": {{ query_noise | default(0) }},
        "query_seed": {{ query_seed | default(1) }},
        {% if time_period is defined %}
        "timed": true,
        {% endif %}
        "body": {{ query_body | default ({}) | tojson }}
    },
    {% if target_throughput is defined %}
    "target-throughput": {{ target_throughput }},
    {% endif %}
    {% if warmup_time_period is defined %}
    "warmup-time-period": {{ warmup_time_period }},
    {% endif %}
    {% if time_period is defined %}
    "time-period": {{ time_period }},
    {% endif %}
    "clients": {{ search_clients | default(1) }}
}
